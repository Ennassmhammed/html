@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@100;200;300;400;500;600;700;800;900& display=swap');
*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: "Poppins";
}
 
#container{
    display: flex;
    flex-wrap: wrap;/* les éléments dessus par dessus, réduction fenetre (en mode tablette telephone*/
    min-height: 100vh;
    background: rgba(68, 117, 136, 0.548);
    justify-content: center;
    align-items: center;
    gap: 20px;
}
 
.card{
    background: white;
    width: 300px;
    border-radius: 10px;
    overflow: hidden;
    /*margin: 10px;*/
    box-shadow: rgba(50, 50, 93, 0.25) 0px 30px 60px -12px, rgba(0, 0, 0, 0.3) 0px 18px 36px -18px;
    transition: 0.5s;/*pas oublier le transition sinon transform on voit pas le mouvement, peut être mis meme dans cardhover*/
}
.card:hover{/*le hover que la souris utilise*/
    transform:translateY(-15px);/*monte la carte vers le haut si + bas et transform:scale=zoom;*/
   
}
.card:hover .coeur{
    left: 0;
    opacity: 1;
}
.card:hover .card-header img{
    transform:scale(1.1);
    filter: grayscale(0);
 
}
 
.card-header{
    position: relative;
    height: 200px;
    overflow: hidden;
}
 
.card-header>img{
    width: 100%;
    height: 100%;
    /*border-radius: 10px 10px 0 0;*/
    object-fit: cover;
    filter: grayscale(1);
    transition: 0.5s;
}
 
 
 
.card-text{
    padding: 30px;
}
.card-text h1{
    font-size: 25px;
    margin-bottom: 10px;
    font-weight:700;
}
.card-text p {
    font-size: 14xp;
    color: rgb(150, 150, 150)  ;
    font-weight: 300;
}
 
.coeur{
    display: flex;
    justify-content: center;/*en haut au milieu*/
    align-items: center;/* au milieu*/
    width: 50px;
    height: 50px;
    background: red;
    color: white;
    font-size: 20px;
    position: absolute;/*pour placer ou on veut, y faut que le parent de coeur "cardheader" doit etre relative*/
    top: 0;
    left: -50px;
    transition: 0.5s;
    opacity: 0;
}
.coeur a {
    color: white;
}
 